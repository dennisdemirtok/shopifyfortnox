# ─────────────────────────────────────────────────────────────
#  IAE Shopify → Fortnox — miljövariabler
#  Kopiera till .env och fyll i. .env committas ALDRIG (gitignored).
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
# Vilken roll processen kör: web | worker | all
ROLE=all
PORT=8080
LOG_LEVEL=info

# Publik bas-URL för tjänsten (används för OAuth-callback och webhook-URL).
# Lokalt: använd en tunnel (cloudflared/ngrok) eller http://localhost:8080.
APP_BASE_URL=http://localhost:8080

# ── Persistens ──────────────────────────────────────────────
DATABASE_URL=postgresql://iae:iae@localhost:5432/iae?schema=public
REDIS_URL=redis://localhost:6379

# ── Fortnox (OAuth 2.0 Authorization Code Flow) ─────────────
FORTNOX_CLIENT_ID=din-fortnox-client-id
FORTNOX_CLIENT_SECRET=din-fortnox-client-secret
# Måste exakt matcha redirect-URI registrerad på Fortnox-appen.
FORTNOX_REDIRECT_URI=http://localhost:8080/oauth/fortnox/callback
# Be om ALLA scopes från start (kan ej läggas till i efterhand utan återaktivering).
FORTNOX_SCOPES=customer article order invoice bookkeeping companyinformation
FORTNOX_API_BASE=https://api.fortnox.se
FORTNOX_AUTH_BASE=https://apps.fortnox.se/oauth-v1
# Global throttle (delas över alla storefronts/workers): 25 anrop / 5000 ms.
FORTNOX_RATE_MAX=25
FORTNOX_RATE_WINDOW_MS=5000

# ── Shopify (Admin GraphQL) ─────────────────────────────────
SHOPIFY_SHOP_DOMAIN=viwrsi-jk.myshopify.com
# App client id (Dev Dashboard → Settings → Credentials). Publikt.
SHOPIFY_API_KEY=din-shopify-client-id
# App client secret — för webhook-HMAC OCH OAuth-token-utbyte.
SHOPIFY_API_SECRET=din-shopify-client-secret
# Lämna tomt för att hämta Admin-token via OAuth-install (/oauth/shopify/start).
# Sätt bara om du har en färdig statisk Admin API-token.
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-01
SHOPIFY_SCOPES=read_companies,write_companies,read_customers,write_customers,read_orders,read_products

# ── Moms / VIES ─────────────────────────────────────────────
VIES_ENABLED=true
VIES_ENDPOINT=https://ec.europa.eu/taxation_customs/vies/rest-api/check-vat-number

# ── Larm (dead-letter) ──────────────────────────────────────
# Lämna SMTP tomt för att bara logga larm (ingen e-post skickas).
ALERT_EMAIL_TO=dennis.demirtok@gmail.com
ALERT_EMAIL_FROM=larm@flattered.se
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Hemlighet för signering av OAuth-state (CSRF-skydd). Sätt valfri lång sträng.
OAUTH_STATE_SECRET=byt-ut-mot-lang-slumpmassig-strang

# ── B2B-ansökan (Flöde D) ───────────────────────────────────
# Extra origins (kommaseparerat) som får posta till /b2b/apply från storefronten.
# Butikens myshopify-domän tillåts alltid. Lägg till er publika domän här.
B2B_ALLOWED_ORIGINS=
