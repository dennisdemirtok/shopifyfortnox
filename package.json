{
  "name": "iae-shopify-fortnox",
  "version": "0.1.0",
  "private": true,
  "description": "B2B-integration Shopify (Plus) -> Fortnox: kundsynk (Flode A) och orderfakturering (Flode B).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "prisma migrate deploy && node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "provision:webhooks": "tsx src/scripts/provisionWebhooks.ts",
    "provision:list-webhooks": "tsx src/scripts/listWebhooks.ts",
    "sync:articles": "tsx src/scripts/syncArticles.ts",
    "import:customers": "tsx src/scripts/importFortnoxCustomers.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "nodemailer": "^9.0.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prisma": "^6.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
